# Required for Cognee LLM + embeddings (OpenAI by default)
LLM_API_KEY=

# Cognee local library mode (disable multi-user API auth for in-process use)
ENABLE_BACKEND_ACCESS_CONTROL=false

# Retrieval API
APP_NAME=flowy-retrieval-api
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
DEFAULT_DATASET=main_dataset
UPLOAD_DIR=data/uploads
CORS_ORIGINS=*
