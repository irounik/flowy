# Application
APP_NAME=flowy
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Database — defaults to SQLite for local dev; use PostgreSQL in production
DATABASE_URL=sqlite+aiosqlite:///./flowy.db

# Mock LLM (no API key required when true)
MOCK_LLM=true

# Optional integrations
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@flowy.local
